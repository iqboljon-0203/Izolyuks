# Sayt manzili (SEO, sitemap, canonical uchun)
NEXT_PUBLIC_SITE_URL=https://izolyuks.uz

# Admin panel paroli (/admin)
ADMIN_PASSWORD=
# Admin sessiyasini imzolash uchun uzun tasodifiy satr (32+ belgi)
ADMIN_SECRET=

# Telegram buyurtmalar: @BotFather'dan bot tokeni va xabar keladigan chat/guruh ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Blob (admin o'zgarishlari va rasmlar shu yerda saqlanadi).
# Vercel → Storage → Blob yaratilganda avtomatik qo'shiladi.
BLOB_READ_WRITE_TOKEN=

# Google Search Console tasdiqlash kodi (ixtiyoriy)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Yandex Webmaster tasdiqlash kodi (ixtiyoriy)
NEXT_PUBLIC_YANDEX_VERIFICATION=
